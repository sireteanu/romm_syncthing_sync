# RomM Configuration
# ==================
# RomM server URL. This can be a direct IP:PORT or a reverse-proxied domain. 
# HTTP Authentication needs to be enabled. While RomM supports OIDC (and you can still use it there), this app uses only standard http auth.
ROMM_URL=http://RomM-app:8000

# RomM credentials -- default is HTTP auth
# api: needs ROMM_API_TOKEN
# options: api, http
ROMM_AUTH_TYPE=api
ROMM_API_TOKEN=abc123
# http: needs ROMM_USERNAME and ROMM_PASSWORD.
ROMM_USERNAME=user
ROMM_PASSWORD=password

# RomM API pagination limit (number of games to fetch per request)
ROMM_API_LIMIT=50

# Sync Configuration
# ==================
# Uncomment and set ALL_SYNC_FOLDER *only if your saves and states are organized in the same directory*.
# ALL_SYNC_FOLDER=/data/sync
SAVE_SYNC_FOLDER=/data/sync/saves
STATE_SYNC_FOLDER=/data/sync/states

# These are expected to be used as bind mounts. Follow the pattern in docker-compose.yml

# Sync mode: 'periodic' or 'watch'
# - periodic: Runs sync every SYNC_INTERVAL_SECONDS
# - watch: Monitors filesystem for changes and syncs immediately
SYNC_MODE=watch
# (Watch mode) Time to wait after file events have ceased to begin the sync process (watch mode)
WATCHDOG_DELAY_SECONDS=30

# On app startup, run a full sync between local and RomM library regardless of sync_mode.
# If you have a very large library, the initial sync may take a long time. 
# Options: true, false, force (same behavior as FORCE_PUSH_SYNC, but only on startup)
FULL_INITIAL_SYNC=true

# Option to force push updates to RomM even if RomM's file is newer. If you don't specifically need to do this, leave as-is.
FORCE_PUSH_SYNC=false

# (Periodic mode) library sync interval. This also refreshes the RomM library. Has no effect in 'watch' mode.
SYNC_INTERVAL_SECONDS=1800

PLATFORM_MAP_FILE=./platform_mapping.yaml

# Two-way Sync & Approvals (GUI fork)
# ===================================
# Folder -> RomM, for files RomM has never seen (new saves/states):
#   confirm (default): wait for approval in the web UI
#   auto: upload immediately (original romm_sync behaviour)
# Changes to files that are already synced always upload automatically, unless RomM also changed (= conflict).
PUSH_NEW_MODE=confirm

# RomM -> Folder ("reverse sync"): saves/states that are new or newer on RomM.
#   off: never write to the sync folders
#   confirm (default): wait for approval in the web UI
#   auto: download immediately
# Requires the sync folders to be mounted read-write (no ":ro" in docker-compose.yml).
PULL_MODE=confirm

# Watch mode only sees local file changes, so RomM is re-checked on this interval (seconds). 0 = only on "Sync now".
ROMM_POLL_INTERVAL_SECONDS=600

# Overwritten files are backed up to DATA_FOLDER/backups first. Days to keep them (0 = forever).
BACKUP_RETENTION_DAYS=30

# Persistent app data on the host (sync history, pending approvals, backups).
DATA_FOLDER=./data

# Owner for files written into the sync folders. Unraid default: 99 / 100 (nobody:users).
PUID=99
PGID=100

# Web UI
# ======
WEB_UI=true
# Host port for the dashboard (http://<server>:8080)
WEB_HOST_PORT=8080
# Optional basic auth for the dashboard. Leave empty to disable.
WEB_USERNAME=
WEB_PASSWORD=

# Logging Configuration
# =====================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG: Very verbose, includes all API calls and file operations
# INFO: Normal operation logs (recommended)
LOG_LEVEL=INFO

# set timezone based on your location. Only affects the logging.
# Default will be UTC
TZ=America/Los_Angeles 
